@model VetKlinika.Models.Patient
@{
    ViewData["Title"] = "Edit patient";
}
<h1>Edit patient</h1>
<form asp-action="Edit" enctype="multipart/form-data">
    <input type="hidden" asp-for="Id" />
    <input type="hidden" asp-for="PhotoPath" />
    <div asp-validation-summary="ModelOnly" class="text-danger"></div>
    <div class="mb-3"><label asp-for="Name" class="form-label"></label><input asp-for="Name" class="form-control" /><span asp-validation-for="Name" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Species" class="form-label"></label><input asp-for="Species" class="form-control" /><span asp-validation-for="Species" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Breed" class="form-label"></label><input asp-for="Breed" class="form-control" /><span asp-validation-for="Breed" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="Age" class="form-label"></label><input asp-for="Age" type="number" min="0" max="30" class="form-control" /><span asp-validation-for="Age" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="ClientId" class="form-label">Owner</label><select asp-for="ClientId" asp-items="ViewBag.ClientId" class="form-select"><option value="">-- Select owner --</option></select><span asp-validation-for="ClientId" class="text-danger"></span></div>
    <div class="mb-3"><label asp-for="PhotoFile" class="form-label">Profile picture</label><input asp-for="PhotoFile" type="file" accept=".jpg,.jpeg,.png,.gif,.webp" class="form-control" /><span asp-validation-for="PhotoFile" class="text-danger"></span></div>
    <button type="submit" class="btn btn-primary">Save</button>
    <a asp-action="Index" class="btn btn-secondary">Cancel</a>
</form>
