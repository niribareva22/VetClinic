@model VetKlinika.Models.Patient
@{
    ViewData["Title"] = "Patient details";
}
<h1>Patient details</h1>
@if (!string.IsNullOrEmpty(Model.PhotoPath))
{
    <img src="@Url.Action("Photo", new { id = Model.Id })" alt="Photo of @Model.Name" class="img-thumbnail mb-3" style="max-width: 240px;" />
}
<dl class="row">
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Name)</dt><dd class="col-sm-9">@Model.Name</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Species)</dt><dd class="col-sm-9">@Model.Species</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Breed)</dt><dd class="col-sm-9">@Model.Breed</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Age)</dt><dd class="col-sm-9">@Model.Age</dd>
    <dt class="col-sm-3">Owner</dt><dd class="col-sm-9">@Model.Client?.FirstName @Model.Client?.LastName</dd>
</dl>
@if (User.IsInRole("Admin") || User.IsInRole("Vet"))
{
    <a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
}
<a asp-action="Index" class="btn btn-secondary">Back to list</a>
