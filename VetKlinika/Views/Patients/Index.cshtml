@model IEnumerable<VetKlinika.Models.Patient>

@{
    ViewData["Title"] = "Patients";
    var speciesItems = (SelectList)ViewData["SpeciesList"]!;
}

<h1>Patients</h1>

<form asp-action="Index" method="get" class="row g-2 mb-3">
    <div class="col-md-4">
        <input name="searchString" value="@ViewData["SearchString"]" class="form-control" placeholder="Search name, species, or breed" />
    </div>
    <div class="col-md-3">
        <select name="speciesFilter" asp-items="@speciesItems" class="form-select">
            <option value="">All species</option>
        </select>
    </div>
    <div class="col-auto"><button type="submit" class="btn btn-outline-primary">Search</button></div>
</form>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Patient</a>
</p>
<table class="table table-striped">
    <thead>
    <tr>
        <th><a asp-action="Index" asp-route-searchString="@ViewData["SearchString"]" asp-route-speciesFilter="@ViewData["SpeciesFilter"]" asp-route-sortOrder="@(ViewData["SortOrder"]?.ToString() == "name_desc" ? "" : "name_desc")">Name</a></th>
        <th><a asp-action="Index" asp-route-searchString="@ViewData["SearchString"]" asp-route-speciesFilter="@ViewData["SpeciesFilter"]" asp-route-sortOrder="@(ViewData["SortOrder"]?.ToString() == "species" ? "species_desc" : "species")">Species</a></th>
        <th><a asp-action="Index" asp-route-searchString="@ViewData["SearchString"]" asp-route-speciesFilter="@ViewData["SpeciesFilter"]" asp-route-sortOrder="@(ViewData["SortOrder"]?.ToString() == "age" ? "age_desc" : "age")">Age</a></th>
        <th>Owner</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.Species)</td>
            <td>@Html.DisplayFor(modelItem => item.Age)</td>
            <td>@item.Client?.FirstName @item.Client?.LastName</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>

@if ((int)ViewData["TotalPages"]! > 1)
{
    <nav aria-label="Patient pages">
        <ul class="pagination">
            @for (var pageNumber = 1; pageNumber <= (int)ViewData["TotalPages"]!; pageNumber++)
            {
                <li class="page-item @(pageNumber == (int)ViewData["PageNumber"]! ? "active" : "")">
                    <a class="page-link" asp-action="Index" asp-route-pageNumber="@pageNumber"
                       asp-route-searchString="@ViewData["SearchString"]"
                       asp-route-speciesFilter="@ViewData["SpeciesFilter"]"
                       asp-route-sortOrder="@ViewData["SortOrder"]">@pageNumber</a>
                </li>
            }
        </ul>
    </nav>
}