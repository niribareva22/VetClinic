@model IEnumerable<VetKlinika.Models.Patient>

@{
    ViewData["Title"] = "Patients";
}

<h1>Patients</h1>

<p>
    <a asp-action="Create" class="btn btn-primary">Create New Patient</a>
</p>
<table class="table table-striped">
    <thead>
    <tr>
        <th>@Html.DisplayNameFor(model => model.Name)</th>
        <th>@Html.DisplayNameFor(model => model.Species)</th>
        <th>@Html.DisplayNameFor(model => model.Age)</th>
        <th>Owner</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@Html.DisplayFor(modelItem => item.Name)</td>
            <td>@Html.DisplayFor(modelItem => item.Species)</td>
            <td>@Html.DisplayFor(modelItem => item.Age)</td>
            <td>@item.Client?.FirstName @item.Client?.LastName</td>
            <td>
                <a asp-action="Edit" asp-route-id="@item.PatientID" class="btn btn-sm btn-warning">Edit</a>
                <a asp-action="Details" asp-route-id="@item.PatientID" class="btn btn-sm btn-info">Details</a>
                <a asp-action="Delete" asp-route-id="@item.PatientID" class="btn btn-sm btn-danger">Delete</a>
            </td>
        </tr>
    }
    </tbody>
</table>