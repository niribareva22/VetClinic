@model ErrorViewModel
@{
    ViewData["Title"] = "Something went wrong";
}

<h1>Something went wrong</h1>
<p>The request could not be completed. Please try again.</p>

@if (Model.ShowRequestId)
{
    <p><strong>Request ID</strong> <code>@Model.RequestId</code></p>
}

<a class="btn btn-primary" asp-controller="Home" asp-action="Index">Back to home</a>
