@model IEnumerable<VetKlinika.Models.Appointment>

@{
    ViewData["Title"] = "Appointments";
}

<h1>Appointments</h1>

@if (User.IsInRole("Admin") || User.IsInRole("Vet"))
{
    <p>
        <a asp-action="Create" class="btn btn-primary">Schedule New Appointment</a>
    </p>
}
<table class="table table-striped">
    <thead>
    <tr>
        <th><a asp-action="Index" asp-route-sortOrder="@ViewData["NextDateSort"]">Date &amp; Time</a></th>
        <th>Patient</th>
        <th>Vet</th>
        <th>Service</th>
        <th>Status</th>
        <th>Actions</th>
    </tr>
    </thead>
    <tbody>
    @foreach (var item in Model) {
        <tr>
            <td>@item.AppointmentDateTime.ToLocalTime().ToString("g")</td>
            <td>@item.Patient?.Name</td>
            <td>@item.Vet?.FirstName @item.Vet?.LastName</td>
            <td>@item.Service?.ServiceName</td>
            <td>@Html.DisplayFor(modelItem => item.Status)</td>
            <td>
                @if (User.IsInRole("Admin") || User.IsInRole("Vet"))
                {
                    <a asp-action="Edit" asp-route-id="@item.Id" class="btn btn-sm btn-warning">Edit</a>
                }
                <a asp-action="Details" asp-route-id="@item.Id" class="btn btn-sm btn-info">Details</a>
                @if (User.IsInRole("Admin"))
                {
                    <a asp-action="Delete" asp-route-id="@item.Id" class="btn btn-sm btn-danger">Delete</a>
                }
            </td>
        </tr>
    }
    </tbody>
</table>