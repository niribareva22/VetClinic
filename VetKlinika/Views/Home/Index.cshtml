@{
    ViewData["Title"] = "Home Page";
}

<div class="text-center py-5">
    <h1 class="display-4 fw-bold text-primary">VetKlinika Management System</h1>
    <p class="lead text-muted">Professional care and management for your beloved pets, clients, and appointments.</p>
    
    <hr class="my-4 w-50 mx-auto">

    <div class="row mt-5">
        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h3 class="card-title text-secondary">Clients & Patients</h3>
                        <p class="card-text">Manage client contact details and track pet profiles, species, and ages easily.</p>
                    </div>
                    <div class="mt-3">
                        <a class="btn btn-outline-primary btn-sm me-2" asp-controller="Clients" asp-action="Index">Manage Clients</a>
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Patients" asp-action="Index">Manage Patients</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h3 class="card-title text-secondary">Vets & Services</h3>
                        <p class="card-text">Keep track of your specialized veterinary staff and available clinic services/pricing.</p>
                    </div>
                    <div class="mt-3">
                        <a class="btn btn-outline-primary btn-sm me-2" asp-controller="Vets" asp-action="Index">View Vets</a>
                        <a class="btn btn-outline-secondary btn-sm" asp-controller="Services" asp-action="Index">View Services</a>
                    </div>
                </div>
            </div>
        </div>

        <div class="col-md-4 mb-4">
            <div class="card shadow-sm h-100">
                <div class="card-body d-flex flex-column justify-content-between">
                    <div>
                        <h3 class="card-title text-secondary">Appointments</h3>
                        <p class="card-text">Schedule, manage, and monitor upcoming patient examinations and treatments.</p>
                    </div>
                    <div class="mt-3">
                        <a class="btn btn-primary btn-sm" asp-controller="Appointments" asp-action="Index">Go to Appointments</a>
                    </div>
                </div>
            </div>
        </div>
    </div>
</div>