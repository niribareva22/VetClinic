@model VetKlinika.Models.Vet
@{
    ViewData["Title"] = "Vet details";
}
<h1>Vet details</h1>
<dl class="row">
    <dt class="col-sm-3">Name</dt><dd class="col-sm-9">@Model.FirstName @Model.LastName</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Specialization)</dt><dd class="col-sm-9">@Model.Specialization</dd>
    <dt class="col-sm-3">@Html.DisplayNameFor(m => m.Email)</dt><dd class="col-sm-9">@Model.Email</dd>
</dl>
<a asp-action="Edit" asp-route-id="@Model.Id" class="btn btn-warning">Edit</a>
<a asp-action="Index" class="btn btn-secondary">Back to list</a>
