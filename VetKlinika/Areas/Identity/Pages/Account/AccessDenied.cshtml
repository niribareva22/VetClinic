@page
@model AccessDeniedModel
@{
    ViewData["Title"] = "Access Denied";
}

<div class="container text-center py-5">
    <div class="card shadow-sm mx-auto style-card" style="max-width: 500px;">
        <div class="card-body p-4">
            <div class="text-danger mb-3">
                <svg xmlns="http://www.w3.org/2000/svg" width="64" height="64" fill="currentColor" class="bi bi-shield-lock-fill" viewBox="0 0 16 16">
                    <path fill-rule="evenodd" d="M8 0c-.69 0-1.843.265-2.928.56-1.11.3-2.229.655-2.887.87a1.54 1.54 0 0 0-1.044 1.262c-.596 4.477.787 7.795 2.465 9.99a11.8 11.8 0 0 0 4.12 3.16.8.8 0 0 0 .548 0 11.8 11.8 0 0 0 4.12-3.16c1.678-2.195 3.061-5.513 2.465-9.99a1.54 1.54 0 0 0-1.044-1.263 63 63 0 0 0-2.887-.87C9.843.266 8.69 0 8 0m0 5a1.5 1.5 0 0 1 .5 2.915V9.5a.5.5 0 0 1-1 0V7.915A1.5 1.5 0 0 1 8 5"/>
                </svg>
            </div>
            
            <h2 class="card-title text-danger fw-bold mb-2">Access Denied</h2>
            <p class="card-text text-muted mb-4">
                You do not have permission to access or perform this action.
            </p>

            <div class="d-grid gap-2">
                <button onclick="history.back()" class="btn btn-secondary btn-lg">
                    &larr; Go Back to Where You Were
                </button>
                <a asp-area="" asp-controller="Home" asp-action="Index" class="btn btn-outline-primary">
                    Return to Homepage
                </a>
            </div>
        </div>
    </div>
</div>